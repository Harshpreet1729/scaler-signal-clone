FRONTEND_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/signal.sqlite3
# Railway: DATABASE_PATH=/data/signal.sqlite3 on a mounted /data volume.
# Production start: python -m app.startup (migrates at runtime; never seeds).
# Server-only shared key, generated locally. Never put this in NEXT_PUBLIC_*.
INTERNAL_API_KEY=
SESSION_SECONDS=604800
CHALLENGE_SECONDS=300
# Combined challenge/register/login attempts per gateway IP per minute, one worker.
AUTH_RATE_LIMIT=30

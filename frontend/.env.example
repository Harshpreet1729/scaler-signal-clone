# Server-only origin. Never prefix this variable with NEXT_PUBLIC_.
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Match backend's server-only value; never expose as NEXT_PUBLIC_*.
INTERNAL_API_KEY=
# Browser WebSocket endpoint; use wss:// with an HTTPS frontend in deployment.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/v1/ws
# NEXT_PUBLIC_WS_URL is embedded during npm run build; Railway must set wss://... before building.
# Production start: npm run start:production (0.0.0.0, PORT from process environment).
